import Ruliology.CellularAutomata.Rule30Prize
import Ruliology.CellularAutomata.Rule30PeriodTwoLanguage
import Ruliology.CellularAutomata.Rule30EtherThreeSkeleton

/-!
# Period 3: the language of the bad class of the right strip

`Rule30PeriodTwoLanguage` reads the paths inside the bad class of a bad-class certificate at period `2`.
This module does the same at period `3`. If the center column is `001`- or `011`-periodic from `T`, the
strip of columns `1..b` of the true right half eventually stays in the bad class
(`Rule30PeriodFourSkeleton.Cert.sound_bad`, masked Jen). `occurs3 C bad R pat = false` means that no path
of the strip relaxation that stays in the bad class reads `pat` in column `1` at the phase `R` of
consecutive periods (subset simulation over bitmasks of strips, three ticks per letter). `no_pattern3`
combines the two.
-/

namespace Rule30Submission

open Ruliology.CellularAutomata

open Rule30Jen Rule30StripCertificates Rule30PeriodFourSkeleton Rule30PeriodTwoLanguage
open Rule30EtherThree

/-- The contribution of the inputs `x1`, `x2`, `x3` to the successors of `s` three ticks later (from
phase `R` back to phase `R`) that stay in the bad class at every tick and read `y` in column `1`. -/
def cont3 (C : Cert) (bad R : Nat) (s : List Bool) (y x1 x2 x3 : Bool) : Nat :=
  let s1 := lin3 (C.wAt R :: (s ++ [x1]))
  let s2 := lin3 (C.wAt ((R + 1) % 3) :: (s1 ++ [x2]))
  let s3 := lin3 (C.wAt ((R + 2) % 3) :: (s2 ++ [x3]))
  if (inBad C bad ((R + 1) % 3) s1 && inBad C bad ((R + 2) % 3) s2 && inBad C bad R s3 &&
      (s3.headD false == y)) = true then 2 ^ encList s3 else 0

def succMask3 (C : Cert) (bad R : Nat) (s : List Bool) (y : Bool) : Nat :=
  cont3 C bad R s y false false false ||| cont3 C bad R s y false false true |||
  cont3 C bad R s y false true false ||| cont3 C bad R s y false true true |||
  cont3 C bad R s y true false false ||| cont3 C bad R s y true false true |||
  cont3 C bad R s y true true false ||| cont3 C bad R s y true true true

/-- One step of the subset simulation: from the strips in `S` (phase `R`) to their successors three
ticks later inside the bad class, reading `y`. -/
def occStep3 (C : Cert) (bad R : Nat) (S : Nat) (y : Bool) : List (List Bool) → Nat
  | [] => 0
  | s :: rest => (if S.testBit (encList s) = true then succMask3 C bad R s y else 0) |||
      occStep3 C bad R S y rest

/-- The phase-`R` strips of the bad class that read `y`. -/
def startMask3 (C : Cert) (bad R : Nat) (y : Bool) : List (List Bool) → Nat
  | [] => 0
  | s :: rest => (if (inBad C bad R s && (s.headD false == y)) = true then 2 ^ encList s else 0) |||
      startMask3 C bad R y rest

def simMask3 (C : Cert) (bad R : Nat) : Nat → List Bool → Nat
  | S, [] => S
  | S, y :: ys => simMask3 C bad R (occStep3 C bad R S y (allLists C.b)) ys

/-- Some path inside the bad class reads `pat` at the phase `R` of consecutive periods. -/
def occurs3 (C : Cert) (bad R : Nat) : List Bool → Bool
  | [] => true
  | y :: ys => simMask3 C bad R (startMask3 C bad R y (allLists C.b)) ys != 0

/-! ## Soundness -/

theorem startMask3_bit (C : Cert) (bad R : Nat) (y : Bool) : ∀ (L : List (List Bool)) (s : List Bool),
    s ∈ L → inBad C bad R s = true → s.headD false = y →
    (startMask3 C bad R y L).testBit (encList s) = true
  | [], s, h, _, _ => by simp at h
  | s' :: rest, s, h, h1, h2 => by
    simp only [startMask3, Nat.testBit_or, Bool.or_eq_true]
    rcases List.mem_cons.1 h with rfl | h
    · left
      have hc : (inBad C bad R s && (s.headD false == y)) = true := by rw [h1, h2]; simp
      rw [testBit_ite, decide_eq_true hc, Bool.true_and, Nat.testBit_two_pow_self]
    · right; exact startMask3_bit C bad R y rest s h h1 h2

theorem occStep3_bit (C : Cert) (bad R : Nat) (S : Nat) (y : Bool) :
    ∀ (L : List (List Bool)) (s s1 s2 s3 : List Bool) (x1 x2 x3 : Bool), s ∈ L →
    S.testBit (encList s) = true →
    s1 = lin3 (C.wAt R :: (s ++ [x1])) → s2 = lin3 (C.wAt ((R + 1) % 3) :: (s1 ++ [x2])) →
    inBad C bad ((R + 1) % 3) s1 = true → inBad C bad ((R + 2) % 3) s2 = true →
    s3 = lin3 (C.wAt ((R + 2) % 3) :: (s2 ++ [x3])) →
    inBad C bad R s3 = true → s3.headD false = y →
    (occStep3 C bad R S y L).testBit (encList s3) = true
  | [], s, _, _, _, _, _, _, h, _, _, _, _, _, _, _, _ => by simp at h
  | s' :: rest, s, s1, s2, s3, x1, x2, x3, h, hS, hs1, hs2, h1, h2, hs3, h3, hy => by
    simp only [occStep3, Nat.testBit_or, Bool.or_eq_true]
    rcases List.mem_cons.1 h with rfl | h
    · left
      rw [testBit_ite, decide_eq_true hS, Bool.true_and]
      have hc : (cont3 C bad R s y x1 x2 x3).testBit (encList s3) = true := by
        subst hs1 hs2 hs3
        have hcond : (inBad C bad ((R + 1) % 3) (lin3 (C.wAt R :: (s ++ [x1]))) &&
            inBad C bad ((R + 2) % 3) (lin3 (C.wAt ((R + 1) % 3) :: (lin3 (C.wAt R :: (s ++ [x1])) ++ [x2]))) &&
            inBad C bad R (lin3 (C.wAt ((R + 2) % 3) ::
              (lin3 (C.wAt ((R + 1) % 3) :: (lin3 (C.wAt R :: (s ++ [x1])) ++ [x2])) ++ [x3]))) &&
            ((lin3 (C.wAt ((R + 2) % 3) ::
              (lin3 (C.wAt ((R + 1) % 3) :: (lin3 (C.wAt R :: (s ++ [x1])) ++ [x2])) ++ [x3]))).headD false
              == y)) = true := by
          rw [h1, h2, h3, hy]; simp
        unfold cont3
        simp only
        rw [testBit_ite, decide_eq_true hcond, Bool.true_and, Nat.testBit_two_pow_self]
      unfold succMask3
      simp only [Nat.testBit_or]
      cases x1 <;> cases x2 <;> cases x3 <;> simp [hc]
    · right; exact occStep3_bit C bad R S y rest s s1 s2 s3 x1 x2 x3 h hS hs1 hs2 h1 h2 hs3 h3 hy

/-- **Soundness of `occurs3`.** Let the center column be `C.w`-periodic from `T` with `C.w` of length `3`,
and let the strip stay in the bad class from `T'` on. If `occurs3 C bad R pat = false`, then from any
time `t ≥ T'` of phase `R`, column `1` at the times `t, t + 3, …` does not spell `pat`. -/
theorem no_pattern3 (C : Cert) (bad R : Nat) (hP : C.P = 3) (T T' : Nat) (hTT : T ≤ T')
    (h : ∀ t, T ≤ t → cell t 0 = C.wAt ((t - T) % C.P))
    (hbad : ∀ t, T' ≤ t → C.rk ((t - T) % C.P) (rowR t C.b) = bad) (hb : 0 < C.b)
    (pat : List Bool) (hocc : occurs3 C bad R pat = false) (t : Nat) (ht : T' ≤ t)
    (hph : (t - T) % 3 = R) :
    ¬ ∀ i, i < pat.length → cell (t + 3 * i) 1 = pat.getD i false := by
  intro hm
  have hstep : ∀ u, T' ≤ u → (u - T) % 3 = R →
      rowR (u + 1) C.b = lin3 (C.wAt R :: (rowR u C.b ++ [cell u ((C.b : Int) + 1)])) ∧
      rowR (u + 2) C.b =
        lin3 (C.wAt ((R + 1) % 3) :: (rowR (u + 1) C.b ++ [cell (u + 1) ((C.b : Int) + 1)])) ∧
      rowR (u + 3) C.b =
        lin3 (C.wAt ((R + 2) % 3) :: (rowR (u + 2) C.b ++ [cell (u + 2) ((C.b : Int) + 1)])) ∧
      inBad C bad ((R + 1) % 3) (rowR (u + 1) C.b) = true ∧
      inBad C bad ((R + 2) % 3) (rowR (u + 2) C.b) = true ∧
      inBad C bad R (rowR (u + 3) C.b) = true ∧ inBad C bad R (rowR u C.b) = true := by
    intro u hu hpu
    have e0 : cell u 0 = C.wAt R := by rw [h u (by omega), hP, hpu]
    have e1 : cell (u + 1) 0 = C.wAt ((R + 1) % 3) := by
      rw [h (u + 1) (by omega), hP, show (u + 1 - T) % 3 = (R + 1) % 3 by omega]
    have e2 : cell (u + 2) 0 = C.wAt ((R + 2) % 3) := by
      rw [h (u + 2) (by omega), hP, show (u + 2 - T) % 3 = (R + 2) % 3 by omega]
    refine ⟨by rw [rowR_succ, e0], by rw [rowR_succ, e1], by rw [rowR_succ, e2], ?_, ?_, ?_, ?_⟩
    · have := hbad (u + 1) (by omega)
      rw [hP, show (u + 1 - T) % 3 = (R + 1) % 3 by omega] at this
      unfold inBad; rw [this]; simp
    · have := hbad (u + 2) (by omega)
      rw [hP, show (u + 2 - T) % 3 = (R + 2) % 3 by omega] at this
      unfold inBad; rw [this]; simp
    · have := hbad (u + 3) (by omega)
      rw [hP, show (u + 3 - T) % 3 = R by omega] at this
      unfold inBad; rw [this]; simp
    · have := hbad u hu
      rw [hP, hpu] at this
      unfold inBad; rw [this]; simp
  have hhead : ∀ u, (rowR u C.b).headD false = cell u 1 := fun u => rowR_head u C.b hb
  have key : ∀ (ys : List Bool) (S u : Nat), T' ≤ u → (u - T) % 3 = R →
      S.testBit (encList (rowR u C.b)) = true →
      (∀ i, i < ys.length → cell (u + 3 * (i + 1)) 1 = ys.getD i false) →
      (simMask3 C bad R S ys).testBit (encList (rowR (u + 3 * ys.length) C.b)) = true := by
    intro ys
    induction ys with
    | nil => intro S u _ _ hS _; exact hS
    | cons y ys ih =>
      intro S u hu hpu hS hys
      obtain ⟨e1, e2, e3, b1, b2, b3, _⟩ := hstep u hu hpu
      have hnext := occStep3_bit C bad R S y (allLists C.b) (rowR u C.b) (rowR (u + 1) C.b)
        (rowR (u + 2) C.b) (rowR (u + 3) C.b) (cell u ((C.b : Int) + 1))
        (cell (u + 1) ((C.b : Int) + 1)) (cell (u + 2) ((C.b : Int) + 1))
        (allLists_mem _ _ (rowR_length u C.b)) hS e1 e2 b1 b2 e3 b3
        (by rw [hhead]; have := hys 0 (by simp); simpa using this)
      have := ih _ (u + 3) (by omega) (by omega) hnext (fun i hi => by
        have := hys (i + 1) (by simp; omega)
        rw [show u + 3 + 3 * (i + 1) = u + 3 * (i + 1 + 1) by omega]
        simpa using this)
      show (simMask3 C bad R (occStep3 C bad R S y (allLists C.b)) ys).testBit _ = true
      rw [show u + 3 * (y :: ys).length = u + 3 + 3 * ys.length by simp; omega]
      exact this
  cases pat with
  | nil => simp [occurs3] at hocc
  | cons y ys =>
    have hS0 := startMask3_bit C bad R y (allLists C.b) (rowR t C.b)
      (allLists_mem _ _ (rowR_length t C.b))
      (hstep t ht hph).2.2.2.2.2.2 (by rw [hhead]; have := hm 0 (by simp); simpa using this)
    have := key ys _ t ht hph hS0 (fun i hi => by
      have := hm (i + 1) (by simp; omega)
      simpa using this)
    simp only [occurs3] at hocc
    rw [show (simMask3 C bad R (startMask3 C bad R y (allLists C.b)) ys) = 0 by
      revert hocc; cases (simMask3 C bad R (startMask3 C bad R y (allLists C.b)) ys) == 0 <;> simp] at this
    simp at this

/-! ## The word `011`: strip width `7`, reading phase `0` -/

-- bad-class certificate for w = 011, strip width 7, reading phase 0 (generated by gen_cert3.py)
def K011w7_rankP : Nat := 
def K011w7_posP : Nat := 0
def K011w7_perP : Nat := 22388199101269958918561348540384237433454849
def K011w7_wordP : Nat := 0
def K011w7 : Cert where
  w := [false, true, true]
  b := 7
  nranks := 19
  rankP := K011w7_rankP
  posP := K011w7_posP
  perP := K011w7_perP
  wordP := K011w7_wordP
def K011w7_bad : Nat := 0
theorem K011w7_checkb : Cert.checkb K011w7 K011w7_bad = true := by decide +kernel
theorem K011w7_checkGb : Cert.checkGb K011w7 K011w7_bad = true := by decide +kernel
theorem K011w7_occ_ctrl_11 : occurs3 K011w7 K011w7_bad 0 [true, true] = true := by decide +kernel
theorem K011w7_occ_ctrl_0110111 : occurs3 K011w7 K011w7_bad 0 [false, true, true, false, true, true, true] = true := by decide +kernel

/-- The column-`1` words, read at phase `0` of consecutive periods, that no path of the bad class reads beside `011`. -/
def col1Forbidden011 : List (List Bool) :=
  [[false, false], [false, true, true, true, true, false], [true, true, true, false, true, false], [false, true, false, true, false, true, false], [false, true, false, true, true, true, false], [false, true, false, true, true, false, true, false], [true, true, true, false, true, true, true, false], [true, true, true, false, true, true, false, true, false]]

theorem K011w7_occ_all : col1Forbidden011.all (fun p => !occurs3 K011w7 K011w7_bad 0 p) = true := by
  decide +kernel

/-- **Column `1` beside `011`.** If the center column is `011`-periodic from `T`, then from some time on, column
`1` read at phase `0` of consecutive periods never spells a word of `col1Forbidden011`: `00`, `011110`, and the six
longer words listed there. -/
theorem col1_011 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w011 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 3 = 0 → ∀ pat ∈ col1Forbidden011,
      ¬ ∀ i, i < pat.length → cell (t + 3 * i) 1 = pat.getD i false := by
  have hP : K011w7.P = 3 := by decide
  have h' : ∀ t, T ≤ t → cell t 0 = K011w7.wAt ((t - T) % K011w7.P) := by
    intro t ht; rw [h t ht, hP]; rfl
  obtain ⟨T', hT', hbad⟩ := Cert.sound_bad K011w7 K011w7_bad K011w7_checkb K011w7_checkGb
    (by decide) (by decide) T h'
  refine ⟨T', hT', fun t ht hph pat hpat => ?_⟩
  have hx := List.all_eq_true.1 K011w7_occ_all pat hpat
  exact no_pattern3 K011w7 K011w7_bad 0 hP T T' hT' h' hbad (by decide) pat (by simpa using hx) t ht hph

/-- **The free bits beside `011`.** Column `-1` at phase `0` is the complement of column `1`
(`Rule30EtherThree.col_m1_011`), so it never spells the complement of a word of `col1Forbidden011`: in
particular never `11` and never `100001`. -/
theorem free_bits_011 (T : Nat) (h : ∀ t, T ≤ t → cell t 0 = wordAt3 w011 (t - T)) :
    ∃ T', T ≤ T' ∧ ∀ t, T' ≤ t → (t - T) % 3 = 0 → ∀ pat ∈ col1Forbidden011,
      ¬ ∀ i, i < pat.length → cell (t + 3 * i) (-1) = !pat.getD i false := by
  obtain ⟨T', hT', hc⟩ := col1_011 T h
  refine ⟨T', hT', fun t ht hph pat hpat hm => hc t ht hph pat hpat fun i hi => ?_⟩
  have e := (col_m1_011 T h (t + 3 * i) (by omega)).1 (by omega)
  have e2 := e.symm.trans (hm i hi)
  simpa using e2

