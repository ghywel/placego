theorem rowAt_succ_lt (v n : Nat) : rowAt K v (n + 1) < 2 ^ K := by
  simp only [rowAt, Rule30UniversalLeftSide.stepK]
  exact Nat.mod_lt _ (Nat.pow_pos (by omega))

