/-- Read the front at wheel `j + 1` off the state after `j` wheels. -/
theorem F_of_S' {w : Nat → Nat} {j a b : Nat} (h : S w j = (a, b)) : F w (j + 1) = b := by
  rw [← S_snd, h]

theorem FA0_165749 : F wA0 165749 = 333333 := F_of_S' SA0_165748
theorem FA1_165749 : F wA1 165749 = 333257 := F_of_S' SA1_165748
