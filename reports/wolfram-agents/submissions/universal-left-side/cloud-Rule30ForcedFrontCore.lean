theorem R0_eq : R0 = rowAt 53209 B 0 := by decide +kernel
theorem R1_eq : R1 = rowAt 53209 B 1 := by decide +kernel
theorem R2_eq : R2 = rowAt 53209 B 2 := by decide +kernel
theorem R3_eq : R3 = rowAt 53209 B 3 := by decide +kernel
