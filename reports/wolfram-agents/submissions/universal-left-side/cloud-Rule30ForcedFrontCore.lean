/-- The sixteen-bit word of wheel `j`, bit `r` the strip's value at phase `r`, in Horner form. -/
def wd (j : Nat) : Nat := (R0.testBit j).toNat + 2 * ((R1.testBit j).toNat + 2 * ((R2.testBit j).toNat + 2 * ((R3.testBit j).toNat + 2 * ((R4.testBit j).toNat + 2 * ((R5.testBit j).toNat + 2 * ((R6.testBit j).toNat + 2 * ((R7.testBit j).toNat + 2 * ((R8.testBit j).toNat + 2 * ((R9.testBit j).toNat + 2 * ((R10.testBit j).toNat + 2 * ((R11.testBit j).toNat + 2 * ((R12.testBit j).toNat + 2 * ((R13.testBit j).toNat + 2 * ((R14.testBit j).toNat + 2 * ((R15.testBit j).toNat)))))))))))))))

/-- The least offset `k < 16` at which bit `(m + k) % 16` of `w` is set, scanning `k` upward; `16` if none. -/
def srch (w m : Nat) : Nat → Nat
  | 0 => 16
  | fuel + 1 => if w.testBit ((m + (16 - (fuel + 1))) % 16) then 16 - (fuel + 1) else srch w m fuel

/-- One wheel of the recursion on the state `(F j, F (j + 1))`: `F (j + 2)` is the max when the nearer word is white, else
one plus the first black of the nearer word at or after the max. -/
def fstep (j : Nat) (st : Nat × Nat) : Nat × Nat :=
  if wd (j + 1) = 0 then (st.2, max st.1 st.2) else (st.2, max st.1 st.2 + srch (wd (j + 1)) (max st.1 st.2) 16 + 1)

/-- `n` wheels of the recursion from wheel `j`. -/
def frun (j : Nat) : Nat → Nat × Nat → Nat × Nat
  | 0, st => st
  | n + 1, st => frun (j + 1) n (fstep j st)

theorem chunk0 : frun 0 5000 (0, 1) = (9974, 9975) := by decide +kernel
